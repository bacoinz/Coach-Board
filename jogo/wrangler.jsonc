{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach-board",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Gera public/js/comum/*.gen.js (configuração e formações) antes de cada dev/deploy.
  "build": { "command": "node scripts/gerar-comum.mjs && node scripts/gerar-demo.mjs", "watch_dir": ["src", "../assets"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*", "/ws/*", "/sala/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }]
  },
  // SQLite é obrigatório para Durable Objects no plano gratuito.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  "observability": { "enabled": true }
}
