{
  "name": "the-gaffer",
  "version": "0.1.0",
  "private": true,
  "description": "The Gaffer — mercado estilo Monopólio e campeonato entre amigos.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node scripts/gerar-comum.mjs && vitest run",
    "dados": "node scripts/importar-jogadores.mjs",
    "valores": "node scripts/tabela-valores.mjs",
    "simular": "node scripts/simular.mjs",
    "contraste": "node scripts/contraste.mjs",
    "mockup": "node scripts/servir.mjs",
    "fotos": "node scripts/fotos.mjs",
    "bandeiras": "node scripts/copiar-bandeiras.mjs",
    "vendor": "esbuild scripts/three-entrada.mjs --bundle --minify --format=esm --outfile=public/vendor/three.min.js"
  },
  "devDependencies": {
    "flag-icons": "^7.6.0",
    "three": "^0.186.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
